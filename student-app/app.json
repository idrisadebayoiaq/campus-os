{
  "expo": {
    "name": "CampusOS",
    "slug": "campusos-student",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "campusos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-brand.png",
      "resizeMode": "contain",
      "backgroundColor": "#3C315B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campusos.app"
    },
    "android": {
      "package": "com.campusos.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#AB9FF2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CampusOS to access your photos for your profile picture.",
          "cameraPermission": "Allow CampusOS to use your camera for your profile picture and ID verification."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#5B4B8A",
          "defaultChannel": "campusos_default"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow CampusOS to use the microphone for voice and video calls."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-brand.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3C315B",
          "dark": {
            "image": "./assets/splash-brand.png",
            "backgroundColor": "#3C315B"
          }
        }
      ],
      "expo-asset",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CampusOS to use your location to show schools, housing and places near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a94a7f49-cdac-408e-9c6b-d8c4cbacacf6"
      }
    },
    "owner": "epicbda"
  }
}
