# Dependencies — EAS installs these on the build server
node_modules/
**/node_modules/**

# Local native folders — regenerated by EAS prebuild
/android/
/ios/

# Build / IDE junk
**/.gradle/
**/build/
**/.cxx/
.git/
.expo/
.vscode/
*.apk
*.aab
*.log
dist/
.tmp/
tmp/

# Local secrets / credentials (google-services.json is intentionally NOT ignored)
.env
.env.*
!.env.example
*firebase-adminsdk*.json
campusos-*-firebase-adminsdk*.json

# Large / unrelated
**/.eas-*.json
**/.eas-*.err
**/.eas-*.log
docs/
doc/
supabase/
business-portal/
student-website/
